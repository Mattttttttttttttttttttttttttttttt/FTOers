{
  "name": "ftoers-network",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "node scripts/build-shared.mjs",
    "configure": "node scripts/configure-backend.mjs",
    "test": "node tests/static.test.mjs && node --test tests/update-subwebsites.test.mjs",
    "preview": "python3 -m http.server 8080 --bind 127.0.0.1 --directory public",
